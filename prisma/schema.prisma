// SHOGO:CUSTOM-START prisma-header
// Managed by Shogo. Do not add a datasource `url` or change the generator `provider` — the database URL is configured in prisma.config.ts (Prisma 7+).
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}
// SHOGO:CUSTOM-END

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Company {
  id              String   @id @default(cuid())
  name            String
  industry        String
  description     String?
  goals           String?
  services        String?
  targetAudience  String?
  brandInfo       String?
  logo            String?
  status          String   @default("setup")
  ownerEmail      String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  departments     Department[]
  agents          Agent[]
  tasks           Task[]
  brainMemories   BrainMemory[]
  workflows       Workflow[]
  activities      Activity[]

  @@map("companies")
}

model Department {
  id          String   @id @default(cuid())
  name        String
  description String?
  icon        String?
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  agents      Agent[]
  tasks       Task[]
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("departments")
}

model Agent {
  id              String   @id @default(cuid())
  name            String
  role            String
  personality     String?
  skills          String?
  experienceLevel String   @default("mid")
  performanceScore Float  @default(80)
  status          String   @default("active")
  systemPrompt    String?
  avatar          String?
  departmentId    String?
  department      Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tasks           Task[]
  messages        AgentMessage[]
  memories        AgentMemory[]
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("agents")
}

model Task {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String   @default("pending")
  priority    String   @default("medium")
  assigneeId  String?
  assignee    Agent?   @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  departmentId String?
  department  Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  dueDate     DateTime?
  output      String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("tasks")
}

model AgentMessage {
  id        String   @id @default(cuid())
  content   String
  role      String
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("agent_messages")
}

model AgentMemory {
  id        String   @id @default(cuid())
  content   String
  category  String   @default("general")
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("agent_memories")
}

model BrainMemory {
  id        String   @id @default(cuid())
  content   String
  category  String   @default("general")
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("brain_memories")
}

model Workflow {
  id          String   @id @default(cuid())
  name        String
  description String?
  steps       String?
  status      String   @default("active")
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("workflows")
}

model Activity {
  id        String   @id @default(cuid())
  type      String
  message   String
  agentName String?
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("activities")
}
